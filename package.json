{
    "name": "pxt-circuit-playground",
    "version": "0.15.77",
    "description": "MakeCode target for Adafruit Circuit Playground Express and Bluefruit",
    "public": true,
    "keywords": [
        "JavaScript",
        "education",
        "Circuit Playground",
        "Adafruit",
        "pxt",
        "MakeCode",
        "Microsoft MakeCode"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jimparis/pxt-circuit-playground.git"
    },
    "author": "Jim Paris",
    "license": "MIT",
    "homepage": "https://makecode.jim.sh/",
    "files": [
        "README.md",
        "pxtarget.json",
        "targetconfig.json",
        "built/*.js",
        "built/*.json",
        "built/*.d.ts",
        "sim/public",
        "docs/*.md",
        "docs/*/*.md",
        "docs/*/*/*.md",
        "docs/static/*.svg",
        "docs/static/*.png",
        "docs/static/libs/*.png",
        "docs/static/fonts/*",
        "docs/static/icons/favicon.ico"
    ],
    "devDependencies": {
        "@types/dom-mediacapture-record": "1.0.20",
        "@types/marked": "0.3.0",
        "@types/node": "8.10.66",
        "@types/react": "16.4.7",
        "@types/react-dom": "16.0.3",
        "@types/web-bluetooth": "0.0.4",
        "less": "3.13.1",
        "react": "16.8.3",
        "react-dom": "16.11.0",
        "semantic-ui-less": "2.4.1",
        "typescript": "4.8.3"
    },
    "dependencies": {
        "pxt-common-packages": "14.1.3",
        "pxt-core": "file:../pxt"
    },
    "scripts": {
        "ci": "node scripts/pxt-ci.js && npm run test:boards && npm run test:static",
        "test:boards": "node scripts/check-board-contract.js",
        "test:static": "node scripts/pxt-static-check.js",
        "test": "npm run ci",
        "svgo": "glob-exec --foreach \"**/boardhd.svg\" -- \"svgo --config=svgo.yml {{file}} -o {{file.dir}}/board.svg \""
    },
    "overrides": {
        "@blockly/field-grid-dropdown": {
            "blockly": "13.1.1"
        },
        "@blockly/plugin-workspace-search": {
            "blockly": "13.1.1"
        }
    }
}
