{
    "id": "circuitplayground",
    "platformid": "codal",
    "nickname": "circuitplayground",
    "name": "Circuit Playground MakeCode",
    "title": "Circuit Playground MakeCode",
    "description": "A Blocks, JavaScript, and Python editor for the Adafruit Circuit Playground Express and Circuit Playground Bluefruit",
    "corepkg": "core",
    "bundleddirs": [
        "libs/base",
        "libs/base---light",
        "libs/core",
        "libs/core---nrf52",
        "libs/core---samd",
        "libs/pulse",
        "libs/infrared",
        "libs/mixer",
        "libs/mixer---samd",
        "libs/mixer---nrf52",
        "libs/pixel",
        "libs/buttons",
        "libs/touch",
        "libs/light",
        "libs/tests",
        "libs/storage",
        "libs/serial",
        "libs/lightsensor",
        "libs/thermometer",
        "libs/switch",
        "libs/accelerometer",
        "libs/microphone",
        "libs/color",
        "libs/settings",
        "libs/adafruit-circuit-playground-express",
        "libs/adafruit-circuit-playground-bluefruit",
        "libs/circuit-playground"
    ],
    "staticpkgdirs": {
        "base": [
            "libs/adafruit-circuit-playground-express",
            "libs/adafruit-circuit-playground-bluefruit"
        ],
        "extensions": []
    },
    "serial": {
        "useHF2": true,
        "useEditor": true,
        "log": true,
        "editorTheme": {
            "graphBackground": "#d9d9d9",
            "lineColors": [
                "#CC2936",
                "#FFC914",
                "#2EB7ED",
                "#FB48C7",
                "#08415C",
                "#C200C0"
            ]
        }
    },
    "simulator": {
        "autoRun": true,
        "streams": false,
        "aspectRatio": 1.0,
        "parts": true,
        "partsAspectRatio": 0.69,
        "dynamicBoardDefinition": true
    },
    "cloud": {
        "workspace": false,
        "packages": true,
        "sharing": true,
        "thumbnails": true,
        "publishing": true,
        "importing": true,
        "preferredPackages": [],
        "githubPackages": true,
        "cloudProviders": {
            "github": {}
        }
    },
    "runtime": {
        "mathBlocks": true,
        "loopsBlocks": true,
        "logicBlocks": true,
        "variablesBlocks": true,
        "textBlocks": true,
        "listsBlocks": true,
        "functionBlocks": true,
        "functionsOptions": {
            "useNewFunctions": true,
            "extraFunctionEditorTypes": []
        },
        "onStartNamespace": "loops",
        "onStartColor": "#40bf4a",
        "onStartWeight": 100,
        "pauseUntilBlock": {},
        "breakBlock": true,
        "continueBlock": true
    },
    "compile": {
        "isNative": true,
        "useUF2": true,
        "webUSB": true,
        "hidSelectors": [
            {
                "vid": "0x239a",
                "pid": "0x0018",
                "usagePage": "0xff97",
                "usageId": "0x0001"
            },
            {
                "vid": "0x239a",
                "pid": "0x0045",
                "usagePage": "0xff97",
                "usageId": "0x0001"
            }
        ],
        "hasHex": true,
        "saveAsPNG": true,
        "deployDrives": ".*",
        "deployFileMarker": "INFO_UF2.TXT",
        "driveName": "DRIVE",
        "openocdScript": "source [find interface/cmsis-dap.cfg]; set CHIPNAME at91samd21g18; source [find target/at91samdXX.cfg]",
        "flashChecksumAddr": 8372,
        "flashCodeAlign": 256,
        "upgrades": []
    },
    "compileService": {
        "buildEngine": "codal",
        "codalTarget": {
            "name": "missing",
            "url": "https://github.com/microsoft/pxt-does-not-exist",
            "branch": "v0",
            "type": "git"
        },
        "codalBinary": "CIRCUIT_PLAYGROUND",
        "yottaConfig": {
            "pxt": {
                "board": {
                    "id": "BOARD_ID_CPLAY"
                }
            }
        },
        "githubCorePackage": "lancaster-university/codal",
        "gittag": "v0.9.0",
        "serviceId": "codal2cp",
        "dockerImage": "pext/yotta:latest"
    },
    "variants": {
        "nrf52840": {
            "serial": {
                "useHF2": true
            },
            "compile": {
                "openocdScript": "source [find interface/cmsis-dap.cfg]; source [find target/nrf52.cfg]",
                "flashChecksumAddr": 0,
                "webUSB": true,
                "flashEnd": 958464,
                "uf2Family": "0xada52840"
            },
            "compileService": {
                "codalTarget": {
                    "name": "codal-circuit-playground-bluefruit",
                    "url": "https://github.com/jimparis/codal-circuit-playground-bluefruit",
                    "branch": "main",
                    "type": "git"
                },
                "codalBinary": "CIRCUIT_PLAYGROUND_BLUEFRUIT",
                "serviceId": "codal2circuitplaygroundbluefruit",
                "dockerImage": "docker.io/pext/yotta@sha256:54acddef1aac8e4a654e591b617e38da12d784da65e8ddc858e8c28fa8bc24e3",
                "dockerArgs": [],
                "yottaConfig": {
                    "pxt": {
                        "board": {
                            "id": "BOARD_ID_NRF52840"
                        }
                    }
                }
            }
        },
        "samd21": {
            "compile": {
                "hasHex": true,
                "openocdScript": "source [find interface/cmsis-dap.cfg]; set CHIPNAME at91samd21g18; source [find target/at91samdXX.cfg]",
                "openocdScriptAlt": "source [find interface/stlink-v2.cfg]; set CPUTAPID 0x0bc11477; set CHIPNAME at91samd21g18; source [find target/at91samdXX.cfg]",
                "flashEnd": 262144,
                "uf2Family": "0x68ed2b88"
            },
            "compileService": {
                "codalTarget": {
                    "name": "codal-circuit-playground",
                    "url": "https://github.com/lancaster-university/codal-circuit-playground",
                    "branch": "v2.0.4",
                    "type": "git"
                },
                "dockerImage": "pext/yotta:latest",
                "codalBinary": "CIRCUIT_PLAYGROUND"
            }
        }
    },
    "appTheme": {
        "accentColor": "#08415C",
        "backgroundColor": "#202A30",
        "logoUrl": "https://github.com/jimparis/pxt-circuit-playground",
        "logo": "./static/logo.svg",
        "docsLogo": "./static/logo.svg",
        "docsHeader": "Circuit Playground MakeCode",
        "portraitLogo": "./static/logo.svg",
        "footerLogo": "./static/logo.svg",
        "organization": "Circuit Playground MakeCode",
        "organizationText": "Circuit Playground MakeCode",
        "organizationShortText": "Circuit Playground",
        "organizationUrl": "https://makecode.jim.sh/",
        "homeUrl": "https://makecode.jim.sh/",
        "embedUrl": "https://makecode.jim.sh/",
        "privacyUrl": "/privacy",
        "termsOfUseUrl": "/terms",
        "githubUrl": "https://github.com/jimparis/pxt-circuit-playground",
        "feedbackUrl": "https://github.com/jimparis/pxt-circuit-playground/issues",
        "boardName": "Circuit Playground",
        "useTextLogo": "Circuit Playground MakeCode",
        "debugger": true,
        "print": true,
        "chooseBoardOnNewProject": true,
        "lightToc": true,
        "instructions": true,
        "docMenu": [
            {
                "name": "About",
                "path": "/about"
            },
            {
                "name": "Boards",
                "path": "/boards"
            },
            {
                "name": "Blocks",
                "path": "/blocks"
            },
            {
                "name": "JavaScript",
                "path": "/javascript"
            },
            {
                "name": "Reference",
                "path": "/reference"
            },
            {
                "name": "GitHub",
                "path": "https://github.com/jimparis/pxt-circuit-playground"
            }
        ],
        "invertedMenu": true,
        "invertedToolbox": true,
        "invertedMonaco": true,
        "baseTheme": "dark",
        "defaultColorTheme": "circuit-playground-standard",
        "highContrastColorTheme": "pxt-high-contrast",
        "saveInMenu": true,
        "monacoToolbox": true,
        "highContrast": true,
        "greenScreen": true,
        "blocksCollapsing": true,
        "accessibleBlocks": true,
        "simAnimationEnter": "fly right in",
        "simAnimationExit": "fly right out",
        "hasAudio": true,
        "songEditor": true,
        "extendFieldEditors": true,
        "usbDocs": "/device/usb",
        "linuxUdevRulesUrl": "/static/60-circuit-playground-webusb.rules",
        "linuxUdevRulesFileName": "60-circuit-playground-webusb.rules",
        "disableBlockIcons": true,
        "disableAPICache": true,
        "blocklyOptions": {
            "grid": {
                "spacing": 20,
                "length": 2,
                "colour": "rgba(189, 195, 199, 0.20)",
                "snap": true
            }
        },
        "blockColors": {
            "light": "#1264a3",
            "input": "#7f1d7a",
            "music": "#ad321e",
            "loops": "#24812f",
            "logic": "#147a92",
            "math": "#6b3fc7",
            "variables": "#b42347",
            "text": "#a35f00",
            "advanced": "#00272B",
            "functions": "#005a9e",
            "arrays": "#8A1C7C"
        },
        "allowPackageExtensions": true,
        "scriptManager": true,
        "simScreenshot": true,
        "simGif": true,
        "qrCode": true,
        "python": true,
        "pythonToolbox": true,
        "addNewTypeScriptFile": true,
        "alwaysGithubItemBlocks": true,
        "alwaysGithubItem": true,
        "githubBlocksDiff": true,
        "nameProjectFirst": true,
        "showProjectSettings": true,
        "selectLanguage": false,
        "githubEditor": true,
        "tutorialBlocksDiff": true,
        "tutorialExplicitHints": true,
        "chooseLanguageRestrictionOnNewProject": true,
        "openProjectNewTab": true,
        "errorList": true
    },
    "ignoreDocsErrors": false,
    "uploadDocs": false
}
